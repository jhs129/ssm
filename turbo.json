{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "REVALIDATE_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "@repo/types#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "@repo/components#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
